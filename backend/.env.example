# ── Application ──────────────────────────────────────────────
APP_ENV=development
CORS_ORIGINS=http://localhost:3000

# ── Database ─────────────────────────────────────────────────
# Hackathon default (works with zero setup):
DATABASE_URL=sqlite:///./satyasetu.db
# Production path (Postgres + pgvector), e.g.:
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/satyasetu
VECTOR_DATABASE_URL=

# ── Sarvam AI (voice layer) — server-side ONLY, never expose to frontend ──
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v2.5
SARVAM_TTS_MODEL=bulbul:v2

# ── LLM (evidence comparison / explanation layer) ──────────────
# Optional. Without a key, the deterministic rule-based comparator is used.
# The final VERDICT is always decided by app/verification/engine.py, never
# by this model — it only labels individual evidence SUPPORTS/CONTRADICTS/NEUTRAL.
# LLM_PROVIDER: "anthropic" | "groq"
LLM_API_KEY=
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5
# For Groq (OpenAI-compatible, fast inference), set:
# LLM_PROVIDER=groq
# LLM_MODEL=openai/gpt-oss-120b
# (check https://console.groq.com/docs/models for the current model lineup —
# it changes; GroqLLMProvider will 404 loudly and fall through to a clean
# 503 if the configured model has been retired.)

# ── Embeddings ───────────────────────────────────────────────
# Optional. Without a key, a local hashing-based embedding provider is used.
EMBEDDING_API_KEY=
EMBEDDING_PROVIDER=local

# ── Uploads ──────────────────────────────────────────────────
MAX_UPLOAD_MB=8
UPLOAD_RETENTION_HOURS=24

# ── WhatsApp (Meta Cloud API) ────────────────────────────────
# From developers.facebook.com → your app → WhatsApp → API Setup.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Any string you choose — paste the SAME value into Meta's webhook config UI.
WHATSAPP_VERIFY_TOKEN=
# From App Dashboard → Settings → Basic → App Secret. Optional but strongly
# recommended: without it, webhook signature verification is skipped.
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v21.0

# ── Twilio IVR + WhatsApp Sandbox ───────────────────────────
# Configure the Twilio phone number's incoming Voice webhook as:
#   POST https://YOUR-PUBLIC-HOST/api/ivr/voice
# Configure the WhatsApp Sandbox's "when a message comes in" webhook as:
#   POST https://YOUR-PUBLIC-HOST/api/twilio/whatsapp
# Both share the same Account SID / Auth Token. TWILIO_PUBLIC_BASE_URL must
# be the same HTTPS origin Twilio calls — required for signature validation
# when the app is behind a proxy/tunnel (e.g. ngrok).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_PUBLIC_BASE_URL=
TWILIO_VALIDATE_WEBHOOKS=true
